selection_rules:
  -
    id: select_g_atomicrmw_xchg_m32
    priority: 300
    match:
      opcode: G_ATOMICRMW_XCHG
      result_type: { kind: scalar, bits: 64 }
      memory: { index: 0, bytes: 4 }
      target_predicates: [a]
      operand_types:
        - { index: 1, kind: pointer, bits: 64 }
        - { index: 2, kind: scalar, bits: 64 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
        - { index: 2, bank: GPR }
    apply:
      instructions:
        - opcode: AMOSWAP_W
          root: true
          operands: [{ operand: 0 }, { operand: 2 }, { operand: 1 }]
  -
    id: select_g_atomicrmw_xchg_m64
