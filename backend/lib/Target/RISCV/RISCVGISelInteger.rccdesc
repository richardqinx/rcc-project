selection_rules:
  -
    id: select_g_implicit_def
    priority: 100
    match:
      opcode: G_IMPLICIT_DEF
    apply:
      instructions:
        - opcode: IMPLICIT_DEF
          root: true
          operands: [{ operand: 0 }]
  -
    id: select_g_sext_s64_s32
    priority: 500
    match:
      opcode: G_SEXT
      result_type: { kind: scalar, bits: 64 }
      operand_types:
        - { index: 1, kind: scalar, bits: 32 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
    apply:
      instructions:
        - opcode: ADDIW
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { immediate: 0 }]
  -
    id: select_g_sext_s64_s16
    priority: 400
    match:
      opcode: G_SEXT
      result_type: { kind: scalar, bits: 64 }
      operand_types:
        - { index: 1, kind: scalar, bits: 16 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
    apply:
      temporaries:
        - { id: extended, type_from_operand: 0 }
      instructions:
        - opcode: SLLI
          root: true
          operands:
            - { temporary: extended, flags: [define] }
            - { operand: 1 }
            - { immediate: 48 }
        - opcode: SRAI
          root: false
          operands:
            - { operand: 0 }
            - { temporary: extended, flags: [use] }
            - { immediate: 48 }
  -
    id: select_g_sext_s32_s16
    priority: 400
    match:
      opcode: G_SEXT
      result_type: { kind: scalar, bits: 32 }
      operand_types:
        - { index: 1, kind: scalar, bits: 16 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
    apply:
      temporaries:
        - { id: extended, type_from_operand: 0 }
      instructions:
        - opcode: SLLIW
          root: true
          operands:
            - { temporary: extended, flags: [define] }
            - { operand: 1 }
            - { immediate: 16 }
        - opcode: SRAIW
          root: false
          operands:
            - { operand: 0 }
            - { temporary: extended, flags: [use] }
            - { immediate: 16 }
  -
    id: select_g_zext_s64_s32_zba
    priority: 500
    match:
      opcode: G_ZEXT
      result_type: { kind: scalar, bits: 64 }
      target_predicates: [zba]
      operand_types:
        - { index: 1, kind: scalar, bits: 32 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
    apply:
      instructions:
        - opcode: ADD_UW
          root: true
          operands:
            - { operand: 0 }
            - { operand: 1 }
            - { physical_register: X0, flags: [use] }
  -
    id: select_g_zext_s64_s32
    priority: 400
    match:
      opcode: G_ZEXT
      result_type: { kind: scalar, bits: 64 }
      operand_types:
        - { index: 1, kind: scalar, bits: 32 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
    apply:
      temporaries:
        - { id: extended, type_from_operand: 0 }
      instructions:
        - opcode: SLLI
          root: true
          operands:
            - { temporary: extended, flags: [define] }
            - { operand: 1 }
            - { immediate: 32 }
        - opcode: SRLI
          root: false
          operands:
            - { operand: 0 }
            - { temporary: extended, flags: [use] }
            - { immediate: 32 }
  -
    id: select_g_zext_s64_s16
    priority: 400
    match:
      opcode: G_ZEXT
      result_type: { kind: scalar, bits: 64 }
      operand_types:
        - { index: 1, kind: scalar, bits: 16 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
    apply:
      temporaries:
        - { id: extended, type_from_operand: 0 }
      instructions:
        - opcode: SLLI
          root: true
          operands:
            - { temporary: extended, flags: [define] }
            - { operand: 1 }
            - { immediate: 48 }
        - opcode: SRLI
          root: false
          operands:
            - { operand: 0 }
            - { temporary: extended, flags: [use] }
            - { immediate: 48 }
  -
    id: select_g_zext_s32_s16
    priority: 400
    match:
      opcode: G_ZEXT
      result_type: { kind: scalar, bits: 32 }
      operand_types:
        - { index: 1, kind: scalar, bits: 16 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
    apply:
      temporaries:
        - { id: extended, type_from_operand: 0 }
      instructions:
        - opcode: SLLIW
          root: true
          operands:
            - { temporary: extended, flags: [define] }
            - { operand: 1 }
            - { immediate: 16 }
        - opcode: SRLIW
          root: false
          operands:
            - { operand: 0 }
            - { temporary: extended, flags: [use] }
            - { immediate: 16 }
  -
    id: select_g_sext_inreg_s64_32
    priority: 500
    match:
      opcode: G_SEXT_INREG
      result_type: { kind: scalar, bits: 64 }
      operand_types:
        - { index: 1, kind: scalar, bits: 64 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
      operand_immediates:
        - index: 2
          ranges: [{ min: 32, max: 32 }]
    apply:
      instructions:
        - opcode: ADDIW
          root: true
          operands:
            - { operand: 0 }
            - { operand: 1 }
            - { immediate: 0 }
  -
    id: select_g_ptr_add_immediate
    priority: 400
    match:
      opcode: G_PTR_ADD
      result_type: { kind: pointer, bits: 64 }
      operand_types:
        - { index: 1, kind: pointer, bits: 64 }
        - { index: 2, kind: scalar, bits: 64 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
      operand_def_constants:
        - index: 2
          ranges: [{ min: -2048, max: 2047 }]
    apply:
      instructions:
        - opcode: ADDI
          root: true
          operands:
            - { operand: 0 }
            - { operand: 1 }
            - { captured_immediate: 2 }
      erase_operand_definitions: [2]
  -
    id: select_g_ptrmask_immediate
    priority: 400
    match:
      opcode: G_PTRMASK
      result_type: { kind: pointer, bits: 64 }
      operand_types:
        - { index: 1, kind: pointer, bits: 64 }
        - { index: 2, kind: scalar, bits: 64 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
      operand_def_constants:
        - index: 2
          ranges: [{ min: -2048, max: 2047 }]
    apply:
      instructions:
        - opcode: ANDI
          root: true
          operands:
            - { operand: 0 }
            - { operand: 1 }
            - { captured_immediate: 2 }
      erase_operand_definitions: [2]
  -
    id: select_g_ptr_add_register
    priority: 100
    match:
      opcode: G_PTR_ADD
      result_type: { kind: pointer, bits: 64 }
      operand_types:
        - { index: 1, kind: pointer, bits: 64 }
        - { index: 2, kind: scalar, bits: 64 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
        - { index: 2, bank: GPR }
    apply:
      instructions:
        - opcode: ADD
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { operand: 2 }]
  -
    id: select_g_ptrmask_register
    priority: 100
    match:
      opcode: G_PTRMASK
      result_type: { kind: pointer, bits: 64 }
      operand_types:
        - { index: 1, kind: pointer, bits: 64 }
        - { index: 2, kind: scalar, bits: 64 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
        - { index: 2, bank: GPR }
    apply:
      instructions:
        - opcode: AND
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { operand: 2 }]
  -
    id: select_g_add_immediate
    priority: 400
    match:
      opcode: G_ADD
      result_type: { kind: scalar, bits: 64 }
      operand_types:
        - { index: 1, kind: scalar, bits: 64 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
      operand_def_constants:
        - index: 2
          ranges: [{ min: -2048, max: 2047 }]
    apply:
      instructions:
        - opcode: ADDI
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { captured_immediate: 2 }]
      erase_operand_definitions: [2]
  -
    id: select_g_and_immediate
    priority: 400
    match:
      opcode: G_AND
      result_type: { kind: scalar, bits: 64 }
      operand_types:
        - { index: 1, kind: scalar, bits: 64 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
      operand_def_constants:
        - index: 2
          ranges: [{ min: -2048, max: 2047 }]
    apply:
      instructions:
        - opcode: ANDI
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { captured_immediate: 2 }]
      erase_operand_definitions: [2]
  -
    id: select_g_or_immediate
    priority: 400
    match:
