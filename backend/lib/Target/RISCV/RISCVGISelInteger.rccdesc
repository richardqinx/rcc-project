          ranges: [{ min: -2048, max: 2047 }]
    apply:
      instructions:
        - opcode: XORI
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { captured_immediate: 2 }]
      erase_operand_definitions: [2]
  -
    id: select_g_add_register
    priority: 100
    match:
      opcode: G_ADD
      result_type: { kind: scalar, bits: 64 }
      operand_types:
