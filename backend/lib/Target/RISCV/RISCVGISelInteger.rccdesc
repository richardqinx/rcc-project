      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
      operand_def_constants:
        - index: 2
          ranges: [{ min: -2048, max: 2047 }]
    apply:
      instructions:
        - opcode: ORI
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { captured_immediate: 2 }]
      erase_operand_definitions: [2]
  -
    id: select_g_xor_immediate
    priority: 400
    match:
      opcode: G_XOR
      result_type: { kind: scalar, bits: 64 }
      operand_types:
        - { index: 1, kind: scalar, bits: 64 }
      operand_banks:
