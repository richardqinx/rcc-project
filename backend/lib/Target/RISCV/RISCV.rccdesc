schema: rcc-target-description-v2
target:
  namespace: riscv
  name: RISCV
  triple: riscv64-unknown-linux-gnu
  cpu: generic-rv64gc
  abi: lp64d
  data_layout: e-m:e-p:64:64-i64:64-i128:128-n32:64-S128
  features: [i, m, a, f, d, c, zicsr, zifencei]

