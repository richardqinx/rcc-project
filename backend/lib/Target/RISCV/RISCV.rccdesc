register_masks:
  -
    name: CSR_ILP32D_LP64D
    preserved: [X1, X8, X9, X18, X19, X20, X21, X22, X23, X24, X25, X26, X27, F8, F9, F18, F19, F20, F21, F22, F23, F24, F25, F26, F27]

mir_operand_flags:
  direct_mask: 31
  direct:
    - { name: riscv-call, value: 1 }
    - { name: riscv-pcrel-hi, value: 2 }
    - { name: riscv-pcrel-lo, value: 4 }
    - { name: riscv-copy-f32, value: 8 }
    - { name: riscv-copy-f64, value: 16 }
  bitmask: []

calling_conventions:
  -
    id: 1
    symbol: LP64D
    name: lp64d
    integer_register_class: GPR
    floating_register_class: FPR64
    integer_argument_registers: [X10, X11, X12, X13, X14, X15, X16, X17]
    floating_argument_registers: [F10, F11, F12, F13, F14, F15, F16, F17]
    integer_return_registers: [X10, X11]
    floating_return_registers: [F10, F11]
    preserved_mask: CSR_ILP32D_LP64D
    stack_alignment_bytes: 16
    stack_argument_alignment_bytes: 16
    shadow_space_bytes: 0
    supports_varargs: true
    supports_tail_calls: true

named_operands:
  - { id: 1, symbol: RD, name: rd }
  - { id: 2, symbol: RS1, name: rs1 }
  - { id: 3, symbol: RS2, name: rs2 }
  - { id: 4, symbol: IMM, name: imm }
  - { id: 5, symbol: TARGET, name: target }
  - { id: 6, symbol: CSR, name: csr }
  - { id: 7, symbol: ZIMM, name: zimm }
  - { id: 8, symbol: PRED, name: pred }
  - { id: 9, symbol: SUCC, name: succ }
  - { id: 10, symbol: FRD, name: frd }
  - { id: 11, symbol: FRS1, name: frs1 }
  - { id: 12, symbol: FRS2, name: frs2 }
  - { id: 13, symbol: FRS3, name: frs3 }
  - { id: 14, symbol: RM, name: rm }

immediate_predicates:
  - { id: 1, symbol: SIMM12, name: simm12, kind: signed, bits: 12 }
  - { id: 2, symbol: SIMM20, name: simm20, kind: signed, bits: 20 }
  - { id: 3, symbol: UIMM5, name: uimm5, kind: unsigned, bits: 5 }
  - { id: 4, symbol: UIMM6, name: uimm6, kind: unsigned, bits: 6 }
  - { id: 5, symbol: UIMM12, name: uimm12, kind: unsigned, bits: 12 }
  - { id: 6, symbol: UIMM4, name: uimm4, kind: unsigned, bits: 4 }
  - { id: 7, symbol: RM, name: rm, kind: unsigned, bits: 3, allowed_values: [0, 1, 2, 3, 4, 7] }
  - { id: 8, symbol: C_UIMM10_NZ_A4, name: c-uimm10-nz-a4, kind: unsigned, bits: 10, alignment: 4, nonzero: true }
  - { id: 9, symbol: C_UIMM7_A4, name: c-uimm7-a4, kind: unsigned, bits: 7, alignment: 4 }
  - { id: 10, symbol: C_UIMM8_A8, name: c-uimm8-a8, kind: unsigned, bits: 8, alignment: 8 }
  - { id: 11, symbol: C_UIMM8_A4, name: c-uimm8-a4, kind: unsigned, bits: 8, alignment: 4 }
  - { id: 12, symbol: C_UIMM9_A8, name: c-uimm9-a8, kind: unsigned, bits: 9, alignment: 8 }
  - { id: 13, symbol: C_SIMM6, name: c-simm6, kind: signed, bits: 6 }
  - { id: 14, symbol: C_SIMM6_NZ, name: c-simm6-nz, kind: signed, bits: 6, nonzero: true }
