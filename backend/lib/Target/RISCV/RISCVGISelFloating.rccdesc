          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { operand: 2 }, { immediate: 7 }]
  -
    id: select_g_fsub_s32
    priority: 100
    match:
      opcode: G_FSUB
      result_type: { kind: scalar, bits: 32 }
      operand_types:
        - { index: 1, kind: scalar, bits: 32 }
        - { index: 2, kind: scalar, bits: 32 }
      operand_banks:
        - { index: 0, bank: FPR }
        - { index: 1, bank: FPR }
