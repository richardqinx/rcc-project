        - { index: 0, bank: FPR }
        - { index: 1, bank: FPR }
        - { index: 2, bank: FPR }
    apply:
      instructions:
        - opcode: FMUL_D
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { operand: 2 }, { immediate: 7 }]
  -
    id: select_g_fdiv_s32
    priority: 100
    match:
      opcode: G_FDIV
      result_type: { kind: scalar, bits: 32 }
      operand_types:
        - { index: 1, kind: scalar, bits: 32 }
        - { index: 2, kind: scalar, bits: 32 }
      operand_banks:
        - { index: 0, bank: FPR }
        - { index: 1, bank: FPR }
        - { index: 2, bank: FPR }
    apply:
      instructions:
        - opcode: FDIV_S
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { operand: 2 }, { immediate: 7 }]
  -
    id: select_g_fdiv_s64
    priority: 100
    match:
      opcode: G_FDIV
      result_type: { kind: scalar, bits: 64 }
      operand_types:
        - { index: 1, kind: scalar, bits: 64 }
        - { index: 2, kind: scalar, bits: 64 }
      operand_banks:
        - { index: 0, bank: FPR }
        - { index: 1, bank: FPR }
        - { index: 2, bank: FPR }
    apply:
      instructions:
        - opcode: FDIV_D
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { operand: 2 }, { immediate: 7 }]
  -
    id: select_g_fma_s32
    priority: 100
    match:
      opcode: G_FMA
      result_type: { kind: scalar, bits: 32 }
      operand_types:
        - { index: 1, kind: scalar, bits: 32 }
        - { index: 2, kind: scalar, bits: 32 }
        - { index: 3, kind: scalar, bits: 32 }
      operand_banks:
        - { index: 0, bank: FPR }
        - { index: 1, bank: FPR }
        - { index: 2, bank: FPR }
        - { index: 3, bank: FPR }
    apply:
      instructions:
        - opcode: FMADD_S
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { operand: 2 }, { operand: 3 }, { immediate: 7 }]
  -
    id: select_g_fma_s64
    priority: 100
    match:
      opcode: G_FMA
      result_type: { kind: scalar, bits: 64 }
      operand_types:
        - { index: 1, kind: scalar, bits: 64 }
        - { index: 2, kind: scalar, bits: 64 }
        - { index: 3, kind: scalar, bits: 64 }
      operand_banks:
        - { index: 0, bank: FPR }
        - { index: 1, bank: FPR }
        - { index: 2, bank: FPR }
        - { index: 3, bank: FPR }
    apply:
      instructions:
        - opcode: FMADD_D
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { operand: 2 }, { operand: 3 }, { immediate: 7 }]
  -
    id: select_g_fsqrt_s32
    priority: 100
    match:
      opcode: G_FSQRT
      result_type: { kind: scalar, bits: 32 }
      operand_types:
        - { index: 1, kind: scalar, bits: 32 }
      operand_banks:
        - { index: 0, bank: FPR }
        - { index: 1, bank: FPR }
    apply:
      instructions:
        - opcode: FSQRT_S
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { immediate: 7 }]
  -
    id: select_g_fsqrt_s64
    priority: 100
    match:
      opcode: G_FSQRT
      result_type: { kind: scalar, bits: 64 }
      operand_types:
        - { index: 1, kind: scalar, bits: 64 }
      operand_banks:
        - { index: 0, bank: FPR }
        - { index: 1, bank: FPR }
    apply:
      instructions:
        - opcode: FSQRT_D
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { immediate: 7 }]
  -
    id: select_g_fneg_s32
    priority: 100
    match:
      opcode: G_FNEG
      result_type: { kind: scalar, bits: 32 }
      operand_types:
        - { index: 1, kind: scalar, bits: 32 }
      operand_banks:
        - { index: 0, bank: FPR }
        - { index: 1, bank: FPR }
    apply:
      instructions:
        - opcode: FSGNJN_S
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { operand: 1 }]
  -
    id: select_g_fneg_s64
    priority: 100
    match:
      opcode: G_FNEG
      result_type: { kind: scalar, bits: 64 }
      operand_types:
        - { index: 1, kind: scalar, bits: 64 }
      operand_banks:
        - { index: 0, bank: FPR }
        - { index: 1, bank: FPR }
    apply:
      instructions:
        - opcode: FSGNJN_D
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { operand: 1 }]
  -
    id: select_g_fabs_s32
    priority: 100
    match:
      opcode: G_FABS
      result_type: { kind: scalar, bits: 32 }
      operand_types:
        - { index: 1, kind: scalar, bits: 32 }
      operand_banks:
        - { index: 0, bank: FPR }
        - { index: 1, bank: FPR }
    apply:
      instructions:
        - opcode: FSGNJX_S
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { operand: 1 }]
  -
    id: select_g_fabs_s64
    priority: 100
    match:
      opcode: G_FABS
      result_type: { kind: scalar, bits: 64 }
      operand_types:
        - { index: 1, kind: scalar, bits: 64 }
      operand_banks:
        - { index: 0, bank: FPR }
        - { index: 1, bank: FPR }
    apply:
      instructions:
        - opcode: FSGNJX_D
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { operand: 1 }]
  -
    id: select_g_fcopysign_s32_fneg
    priority: 200
    match:
      opcode: G_FCOPYSIGN
      result_type: { kind: scalar, bits: 32 }
      operand_types:
        - { index: 1, kind: scalar, bits: 32 }
        - { index: 2, kind: scalar, bits: 32 }
      operand_banks:
        - { index: 0, bank: FPR }
        - { index: 1, bank: FPR }
        - { index: 2, bank: FPR }
      def_use:
        - operand: 2
          opcode: G_FNEG
          captures:
            - { id: sign, operand: 1 }
    apply:
      instructions:
        - opcode: FSGNJN_S
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { captured_operand: sign }]
      erase_operand_definitions: [2]
  -
    id: select_g_fcopysign_s64_fneg
    priority: 200
    match:
      opcode: G_FCOPYSIGN
      result_type: { kind: scalar, bits: 64 }
      operand_types:
        - { index: 1, kind: scalar, bits: 64 }
        - { index: 2, kind: scalar, bits: 64 }
      operand_banks:
        - { index: 0, bank: FPR }
        - { index: 1, bank: FPR }
        - { index: 2, bank: FPR }
      def_use:
        - operand: 2
          opcode: G_FNEG
          captures:
            - { id: sign, operand: 1 }
    apply:
      instructions:
        - opcode: FSGNJN_D
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { captured_operand: sign }]
      erase_operand_definitions: [2]
  -
    id: select_g_fcopysign_s32_s32
    priority: 100
