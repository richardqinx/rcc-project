        - { index: 1, bank: GPR }
    apply:
      instructions:
        - opcode: LH
          root: true
          operands:
            - { operand: 0 }
            - { complex: addr_reg_imm_base, operand: 1 }
            - { complex: addr_reg_imm_offset, operand: 1 }
  -
    id: select_g_sextload_m32
    priority: 300
    match:
      opcode: G_SEXTLOAD
      memory: { index: 0, bytes: 4 }
      operand_types:
        - { index: 1, kind: pointer, bits: 64 }
      operand_banks:
