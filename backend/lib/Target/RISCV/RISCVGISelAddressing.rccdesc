    apply:
      instructions:
        - opcode: LW
          root: true
          operands:
            - { operand: 0 }
            - { complex: addr_reg_imm_base, operand: 1 }
            - { complex: addr_reg_imm_offset, operand: 1 }
  -
    id: select_g_zextload_m8
    priority: 300
    match:
      opcode: G_ZEXTLOAD
      memory: { index: 0, bytes: 1 }
      operand_types:
        - { index: 1, kind: pointer, bits: 64 }
