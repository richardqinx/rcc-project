selection_rules:
  -
    id: select_g_load_m8
    priority: 300
    match:
      opcode: G_LOAD
      memory: { index: 0, bytes: 1 }
      operand_types:
        - { index: 1, kind: pointer, bits: 64 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
    apply:
      instructions:
        - opcode: LBU
          root: true
          operands:
            - { operand: 0 }
            - { complex: addr_reg_imm_base, operand: 1 }
            - { complex: addr_reg_imm_offset, operand: 1 }
  -
    id: select_g_load_m16
    priority: 300
    match:
      opcode: G_LOAD
      memory: { index: 0, bytes: 2 }
      operand_types:
        - { index: 1, kind: pointer, bits: 64 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
    apply:
      instructions:
        - opcode: LH
          root: true
          operands:
            - { operand: 0 }
            - { complex: addr_reg_imm_base, operand: 1 }
            - { complex: addr_reg_imm_offset, operand: 1 }
  -
    id: select_g_load_m32
    priority: 300
    match:
      opcode: G_LOAD
      memory: { index: 0, bytes: 4 }
      operand_types:
        - { index: 1, kind: pointer, bits: 64 }
