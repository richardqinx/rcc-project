            - { operand: 0 }
            - { complex: addr_reg_imm_base, operand: 1 }
            - { complex: addr_reg_imm_offset, operand: 1 }
  -
    id: select_g_load_m64
    priority: 300
    match:
      opcode: G_LOAD
      memory: { index: 0, bytes: 8 }
      operand_types:
        - { index: 1, kind: pointer, bits: 64 }
      operand_banks:
        - { index: 0, bank: GPR }
        - { index: 1, bank: GPR }
    apply:
      instructions:
        - opcode: LD
          root: true
          operands:
            - { operand: 0 }
            - { complex: addr_reg_imm_base, operand: 1 }
            - { complex: addr_reg_imm_offset, operand: 1 }
  -
    id: select_g_sextload_m8
    priority: 300
    match:
      opcode: G_SEXTLOAD
      memory: { index: 0, bytes: 1 }
      operand_types:
        - { index: 1, kind: pointer, bits: 64 }
