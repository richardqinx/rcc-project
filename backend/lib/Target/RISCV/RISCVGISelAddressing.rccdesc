    apply:
      instructions:
        - opcode: LWU
          root: true
          operands:
            - { operand: 0 }
            - { complex: addr_reg_imm_base, operand: 1 }
            - { complex: addr_reg_imm_offset, operand: 1 }
  -
    id: select_g_frame_index
    priority: 100
    match:
      opcode: G_FRAME_INDEX
      result_type: { kind: pointer, bits: 64 }
      operand_banks:
        - { index: 0, bank: GPR }
    apply:
      instructions:
        - opcode: ADDI
          root: true
          operands: [{ operand: 0 }, { operand: 1 }, { immediate: 0 }]
