@PACKAGE_INIT@

set(RCC_VERSION "@RCC_VERSION@")
set(RCC_VERSION_MAJOR "@RCC_VERSION_MAJOR@")
set(RCC_VERSION_MINOR "@RCC_VERSION_MINOR@")
set(RCC_VERSION_PATCH "@RCC_VERSION_PATCH@")
set(RCC_CMAKE_DIR "@RCC_PACKAGE_MODULE_DIR@")
set(RCC_INCLUDE_DIRS "@RCC_PACKAGE_INCLUDE_DIRS@")
set(RCC_LIBRARY_DIR "@RCC_PACKAGE_LIBRARY_DIR@")
set(RCC_BUILD_LIBRARY_DIR "@RCC_PACKAGE_BUILD_LIBRARY_DIR@")
set(RCC_INSTALL_PREFIX "@RCC_PACKAGE_INSTALL_PREFIX@")
set(RCC_ENABLE_ASSERTIONS "@RCC_ENABLE_ASSERTIONS@")
set(RCC_ENABLE_EH "@RCC_ENABLE_EH@")
set(RCC_ENABLE_RTTI "@RCC_ENABLE_RTTI@")
set(RCC_ENABLE_UNWIND_TABLES "@RCC_ENABLE_UNWIND_TABLES@")
set(RCC_ENABLE_WARNINGS "@RCC_ENABLE_WARNINGS@")
set(RCC_ENABLE_WARNING_SUPPRESSIONS "@RCC_ENABLE_WARNING_SUPPRESSIONS@")
set(RCC_ENABLE_LIBCXX "@RCC_LIBCXX_USED@")
set(RCC_STATIC_LINK_CXX_STDLIB "@RCC_STATIC_LINK_CXX_STDLIB@")
set(GLIBCXX_USE_CXX11_ABI "@GLIBCXX_USE_CXX11_ABI@")
set(RCC_DEFINITIONS "@RCC_DEFINITIONS@")
if(MSVC)
  set(CMAKE_MSVC_RUNTIME_LIBRARY "@RCC_PACKAGE_MSVC_RUNTIME_LIBRARY@")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/RCCTargets.cmake")
