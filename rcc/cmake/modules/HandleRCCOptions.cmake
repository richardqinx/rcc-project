function(rcc_append_flags value)
  foreach(variable IN LISTS ARGN)
    set(${variable} "${${variable}} ${value}" PARENT_SCOPE)
  endforeach()
endfunction()

macro(rcc_add_supported_warning flag name)
  check_c_compiler_flag("-Werror ${flag}" RCC_C_SUPPORTS_${name})
  if(RCC_C_SUPPORTS_${name})
    rcc_append_flags("${flag}" CMAKE_C_FLAGS)
  endif()
  check_cxx_compiler_flag("-Werror ${flag}" RCC_CXX_SUPPORTS_${name})
  if(RCC_CXX_SUPPORTS_${name})
    rcc_append_flags("${flag}" CMAKE_CXX_FLAGS)
  endif()
endmacro()

macro(rcc_configure_job_pools)
  set(RCC_PARALLEL_COMPILE_JOBS "" CACHE STRING "Maximum concurrent compilation jobs (Ninja only)")
  set(RCC_PARALLEL_LINK_JOBS "" CACHE STRING "Maximum concurrent link jobs (Ninja only)")
  if(RCC_RAM_PER_COMPILE_JOB OR RCC_RAM_PER_LINK_JOB)
    cmake_host_system_information(RESULT rccAvailableMemory QUERY AVAILABLE_PHYSICAL_MEMORY)
    cmake_host_system_information(RESULT rccLogicalCores QUERY NUMBER_OF_LOGICAL_CORES)
  endif()
  foreach(rccJobKind COMPILE LINK)
    if(RCC_RAM_PER_${rccJobKind}_JOB)
      math(EXPR rccMemoryJobs "${rccAvailableMemory} / ${RCC_RAM_PER_${rccJobKind}_JOB}" OUTPUT_FORMAT DECIMAL)
      if(rccMemoryJobs LESS 1)
        set(rccMemoryJobs 1)
      endif()
      if(rccMemoryJobs LESS rccLogicalCores)
        set(RCC_PARALLEL_${rccJobKind}_JOBS "${rccMemoryJobs}")
      else()
        set(RCC_PARALLEL_${rccJobKind}_JOBS "${rccLogicalCores}")
      endif()
    endif()
  endforeach()
  if(RCC_PARALLEL_COMPILE_JOBS)
    if(CMAKE_GENERATOR MATCHES "Ninja")
      set_property(GLOBAL APPEND PROPERTY JOB_POOLS compile_job_pool=${RCC_PARALLEL_COMPILE_JOBS})
      set(CMAKE_JOB_POOL_COMPILE compile_job_pool)
    else()
      message(WARNING "Job pooling is only available with Ninja generators.")
    endif()
  endif()
  if(CMAKE_GENERATOR MATCHES "Ninja")
    if(NOT RCC_PARALLEL_LINK_JOBS AND rccLTOMode STREQUAL "THIN")
      message(STATUS "ThinLTO provides its own parallel linking - limiting parallel link jobs to 2.")
      set(RCC_PARALLEL_LINK_JOBS 2)
    endif()
    if(RCC_PARALLEL_LINK_JOBS)
      set_property(GLOBAL APPEND PROPERTY JOB_POOLS link_job_pool=${RCC_PARALLEL_LINK_JOBS})
      set(CMAKE_JOB_POOL_LINK link_job_pool)
    endif()
  elseif(RCC_PARALLEL_LINK_JOBS)
    message(WARNING "Job pooling is only available with Ninja generators.")
  endif()
endmacro()

macro(rcc_configure_platform_checks)
  if(UNIX AND CMAKE_SYSTEM_NAME MATCHES "AIX")
    list(APPEND CMAKE_REQUIRED_DEFINITIONS "-D_XOPEN_SOURCE=700" "-D_LARGE_FILE_API")
  endif()
  if(UNIX AND CMAKE_SYSTEM_NAME MATCHES "SunOS")
    list(APPEND CMAKE_REQUIRED_DEFINITIONS "-D_FILE_OFFSET_BITS=64")
  endif()
  check_symbol_exists(__GLIBC__ stdio.h RCC_USING_GLIBC)
  if(RCC_USING_GLIBC OR CYGWIN)
    add_compile_definitions(_GNU_SOURCE)
    list(APPEND CMAKE_REQUIRED_DEFINITIONS "-D_GNU_SOURCE")
  endif()
  if(RCC_USING_GLIBC AND CMAKE_SIZEOF_VOID_P EQUAL 4)
    add_compile_definitions(_FILE_OFFSET_BITS=64)
    list(APPEND CMAKE_REQUIRED_DEFINITIONS "-D_FILE_OFFSET_BITS=64")
  endif()
  if(NOT RCC_ENABLE_PIC)
    rcc_append_flags("-fno-pie" CMAKE_EXE_LINKER_FLAGS)
  endif()
endmacro()

macro(rcc_configure_platform_link_options)
  if(APPLE)
    rcc_append_flags("-Wl,-flat_namespace -Wl,-undefined -Wl,dynamic_lookup" CMAKE_MODULE_LINKER_FLAGS)
  endif()
  if(CMAKE_SYSTEM_NAME MATCHES "AIX")
    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
      rcc_append_flags("-mcmodel=large" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
      rcc_append_flags("-Wl,-bglink=large" CMAKE_EXE_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "XL")
      rcc_append_flags("-Wl,-bbigtoc -bcdtors:mbr"
        CMAKE_EXE_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    endif()
    if(BUILD_SHARED_LIBS)
      message(WARNING "Build and install environment path info may be exposed; binaries will also be unrelocatable.")
    endif()
  endif()
  if(CMAKE_SYSTEM_NAME MATCHES "OS390")
    rcc_append_flags("-Wl,-bcompress=yes" CMAKE_EXE_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
  endif()
  if(NOT (CMAKE_SYSTEM_NAME MATCHES "Darwin|FreeBSD|OpenBSD|DragonFly|AIX|OS390|Emscripten"
      OR WIN32 OR CYGWIN) AND NOT RCC_USE_SANITIZER)
    rcc_append_flags("-Wl,-z,defs" CMAKE_SHARED_LINKER_FLAGS)
  endif()
endmacro()

macro(rcc_configure_platform_definitions)
  if(UNIX AND CMAKE_SYSTEM_NAME MATCHES "AIX")
    add_compile_definitions(_XOPEN_SOURCE=700 _LARGE_FILE_API)
    add_compile_options(-pthread)
    rcc_append_flags("-shared -Wl,-G" CMAKE_MODULE_LINKER_FLAGS)
    rcc_append_flags("-shared" CMAKE_SHARED_LINKER_FLAGS)
  endif()
  if(CMAKE_SYSTEM_NAME MATCHES "OS390")
    add_compile_definitions(_XOPEN_SOURCE=600 _XPLATFORM_SOURCE _OPEN_SYS _OPEN_SYS_FILE_EXT _EXT)
    rcc_append_flags("-fzos-le-char-mode=ascii -m64" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
  endif()
  if(UNIX AND CMAKE_SYSTEM_NAME MATCHES "SunOS")
    add_compile_definitions(_FILE_OFFSET_BITS=64)
  endif()
endmacro()

macro(rcc_configure_warning_options)
  if(MSVC)
    if(RCC_ENABLE_WERROR)
      rcc_append_flags("/WX" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()
    if(RCC_ENABLE_WARNINGS)
      string(REGEX REPLACE " /W[0-4]" "" CMAKE_C_FLAGS "${CMAKE_C_FLAGS}")
      string(REGEX REPLACE " /W[0-4]" "" CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
      rcc_append_flags("/W4" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()
    if(NOT RCC_CLANG_CL)
      if(RCC_ENABLE_WARNING_SUPPRESSIONS)
        rcc_append_flags(
          "-wd4146 -wd4244 -wd4267 -wd4456 -wd4457 -wd4458 -wd4459 -wd4624 -wd4100 -wd4127 -wd4505 -wd4702 -wd4245 -wd4310 -wd4701 -wd4703 -wd4389 -wd4805 -wd4577 -wd4319 -wd4324 -wd4251 -wd4275"
          CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
      endif()
      rcc_append_flags("-w14062 -we4238" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()
  endif()

  if(RCC_GCC_COMPATIBLE AND RCC_ENABLE_WERROR)
    rcc_append_flags("-Werror" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    rcc_append_flags("-Wno-error" CMAKE_REQUIRED_FLAGS)
  endif()
  if(RCC_GCC_COMPATIBLE OR CMAKE_CXX_COMPILER_ID MATCHES "XL")
    rcc_append_flags("-Werror=date-time" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
  endif()
  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    rcc_append_flags("-Werror=unguarded-availability-new" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
  endif()

  set(rccInitialCFlags "${CMAKE_C_FLAGS}")
  set(rccInitialCXXFlags "${CMAKE_CXX_FLAGS}")
  if(RCC_ENABLE_WARNINGS AND (RCC_GCC_COMPATIBLE OR RCC_CLANG_CL))
    if(NOT RCC_CLANG_CL)
      rcc_append_flags("-Wall" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()
    rcc_append_flags("-Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual"
      CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
      rcc_append_flags("-Wno-missing-field-initializers" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    else()
      rcc_append_flags("-Wmissing-field-initializers" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()

    if(RCC_ENABLE_PEDANTIC AND RCC_GCC_COMPATIBLE)
      rcc_append_flags("-pedantic -Wno-long-long" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
      rcc_add_supported_warning("-Wc++98-compat-extra-semi" CXX98_COMPAT_EXTRA_SEMI)
    endif()
    rcc_append_flags("-Wimplicit-fallthrough" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
      rcc_append_flags("-Wcovered-switch-default" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()

    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
      # Match LLVM's GCC warning suppression policy and version conditions.
      if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS 15.0)
        rcc_append_flags("-Wno-uninitialized" CMAKE_CXX_FLAGS)
      else()
        rcc_append_flags("-Wno-maybe-uninitialized" CMAKE_CXX_FLAGS)
      endif()
      rcc_append_flags("-Wno-nonnull" CMAKE_CXX_FLAGS)
      if(CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 8.1)
        rcc_append_flags("-Wno-class-memaccess" CMAKE_CXX_FLAGS)
      endif()
      if(CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 13.1)
        rcc_append_flags("-Wno-dangling-reference" CMAKE_CXX_FLAGS)
      endif()
      if(CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 9.1)
        rcc_append_flags("-Wno-redundant-move -Wno-pessimizing-move" CMAKE_CXX_FLAGS)
      endif()
      rcc_append_flags("-Wno-array-bounds" CMAKE_CXX_FLAGS)
      if(CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 11.1)
        rcc_append_flags("-Wno-stringop-overread" CMAKE_CXX_FLAGS)
      endif()
      if(CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 12.1)
        rcc_append_flags("-Wno-dangling-pointer" CMAKE_CXX_FLAGS)
      endif()
      if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS 14.0)
        rcc_append_flags("-Wno-unused-but-set-parameter" CMAKE_CXX_FLAGS)
      endif()
    endif()
    rcc_append_flags("-Wno-noexcept-type" CMAKE_CXX_FLAGS)
    if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
      rcc_append_flags("-Wnon-virtual-dtor" CMAKE_CXX_FLAGS)
    endif()
    rcc_append_flags("-Wdelete-non-virtual-dtor" CMAKE_CXX_FLAGS)

    check_cxx_compiler_flag("-Wsuggest-override" RCC_SUPPORTS_SUGGEST_OVERRIDE)
    if(RCC_SUPPORTS_SUGGEST_OVERRIDE)
      cmake_push_check_state()
      string(APPEND CMAKE_REQUIRED_FLAGS " -Werror=suggest-override")
      check_cxx_source_compiles([=[
        class Base { public: virtual void anchor(); };
        class Derived : Base { public: void anchor() final; };
        int main() { return 0; }
      ]=] RCC_SUGGEST_OVERRIDE_ACCEPTS_FINAL)
      cmake_pop_check_state()
      if(RCC_SUGGEST_OVERRIDE_ACCEPTS_FINAL)
        rcc_append_flags("-Wsuggest-override" CMAKE_CXX_FLAGS)
      endif()
    endif()

    cmake_push_check_state()
    string(APPEND CMAKE_REQUIRED_FLAGS " -Werror -Wcomment")
    check_c_source_compiles("// \\\\\\n//\\nint main(void) { return 0; }"
      RCC_C_WCOMMENT_ACCEPTS_LINE_WRAP)
    cmake_pop_check_state()
    if(NOT RCC_C_WCOMMENT_ACCEPTS_LINE_WRAP)
      rcc_append_flags("-Wno-comment" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()

    if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
      rcc_append_flags("-Wstring-conversion" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
      rcc_append_flags("-Wno-pass-failed" CMAKE_CXX_FLAGS)
    endif()
    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
      rcc_append_flags("-Wno-misleading-indentation" CMAKE_CXX_FLAGS)
    else()
      rcc_add_supported_warning("-Wmisleading-indentation" MISLEADING_INDENTATION)
    endif()
    rcc_add_supported_warning("-Wctad-maybe-unsupported" CTAD_MAYBE_UNSUPPORTED)
  elseif(RCC_GCC_COMPATIBLE AND NOT RCC_ENABLE_WARNINGS)
    rcc_append_flags("-w" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
  endif()

  if(NOT RCC_ENABLE_WARNING_SUPPRESSIONS AND (RCC_GCC_COMPATIBLE OR RCC_CLANG_CL))
    foreach(rccLanguage C CXX)
      string(LENGTH "${rccInitial${rccLanguage}Flags}" rccInitialLength)
      string(SUBSTRING "${CMAKE_${rccLanguage}_FLAGS}" ${rccInitialLength} -1 rccAddedFlags)
      string(REGEX REPLACE "(^| +)-Wno-[a-zA-Z0-9_-]+" "" rccAddedFlags "${rccAddedFlags}")
      set(CMAKE_${rccLanguage}_FLAGS "${rccInitial${rccLanguage}Flags}${rccAddedFlags}")
    endforeach()
  endif()
endmacro()

# Configure in the caller's directory scope, as LLVM's option modules do.
macro(rcc_configure_options)
  if(DEFINED CMAKE_CXX_STANDARD AND CMAKE_CXX_STANDARD LESS 23)
    message(FATAL_ERROR "RCC requires CMAKE_CXX_STANDARD to be at least 23")
  endif()
  set(CMAKE_CXX_STANDARD 23 CACHE STRING "C++ standard to conform to")
  set(CMAKE_CXX_STANDARD_REQUIRED YES)
  set(CMAKE_CXX_EXTENSIONS NO)

  if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
    message(WARNING "No build type selected. Defaulted CMAKE_BUILD_TYPE=Release.")
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type: Debug, Release, RelWithDebInfo, MinSizeRel" FORCE)
  endif()
  if(CMAKE_DEFAULT_BUILD_TYPE)
    set(CMAKE_TRY_COMPILE_CONFIGURATION "${CMAKE_DEFAULT_BUILD_TYPE}")
  elseif(CMAKE_CONFIGURATION_TYPES)
    list(GET CMAKE_CONFIGURATION_TYPES 0 CMAKE_TRY_COMPILE_CONFIGURATION)
  elseif(CMAKE_BUILD_TYPE)
    set(CMAKE_TRY_COMPILE_CONFIGURATION "${CMAKE_BUILD_TYPE}")
  endif()
  set(RCC_ADDITIONAL_BUILD_TYPES "" CACHE STRING "Additional allowed CMake build types")
  set(rccAllowedBuildTypes DEBUG RELEASE RELWITHDEBINFO MINSIZEREL ${RCC_ADDITIONAL_BUILD_TYPES})
  string(REPLACE ";" "|" rccAllowedBuildTypes "${rccAllowedBuildTypes}")
  string(TOUPPER "${rccAllowedBuildTypes}" rccAllowedBuildTypes)
  set(assertionsDefault OFF)
  string(TOUPPER "${CMAKE_BUILD_TYPE}" buildType)
  if(CMAKE_BUILD_TYPE AND NOT buildType MATCHES "^(${rccAllowedBuildTypes})$")
    message(FATAL_ERROR "Unknown value for CMAKE_BUILD_TYPE: ${CMAKE_BUILD_TYPE}")
  endif()
  if(buildType STREQUAL "DEBUG")
    set(assertionsDefault ON)
  endif()
  option(RCC_ENABLE_WARNINGS "Enable compiler warnings" ON)
  option(RCC_ENABLE_WARNING_SUPPRESSIONS "Suppress compiler warnings" ON)
  option(RCC_ENABLE_PEDANTIC "Compile with pedantic enabled" ON)
  option(RCC_ENABLE_WERROR "Treat compiler warnings as errors" OFF)
  option(RCC_ENABLE_ASSERTIONS "Enable assertions" "${assertionsDefault}")
  option(RCC_ENABLE_EH "Enable C++ exceptions" OFF)
  option(RCC_ENABLE_RTTI "Enable C++ runtime type information" OFF)
  option(RCC_ENABLE_UNWIND_TABLES "Emit unwind tables for the libraries" ON)
  set(RCC_USE_SANITIZER "" CACHE STRING
    "Sanitizer used to build binaries; use LLVM's platform-specific combinations")
  option(RCC_OPTIMIZE_SANITIZED_BUILDS "Use -O1 for Debug sanitizer builds" ON)
  set(RCC_UBSAN_FLAGS
    "-fsanitize=undefined -fno-sanitize=vptr,function -fno-sanitize-recover=all"
    CACHE STRING "Compiler flags for the Undefined sanitizer")

  if(RCC_ENABLE_EH AND NOT RCC_ENABLE_RTTI)
    message(FATAL_ERROR "RCC_ENABLE_EH requires RCC_ENABLE_RTTI.")
  endif()

  if(NOT DEFINED RCC_GCC_COMPATIBLE)
    if(CMAKE_COMPILER_IS_GNUCXX)
      set(RCC_GCC_COMPATIBLE ON)
    elseif(MSVC)
      set(RCC_GCC_COMPATIBLE OFF)
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang|Intel")
      set(RCC_GCC_COMPATIBLE ON)
    endif()
  endif()
  set(RCC_CLANG_CL OFF)
  if(MSVC AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    set(RCC_CLANG_CL ON)
  endif()

  if(WIN32)
    set(RCC_ON_UNIX OFF)
  elseif(FUCHSIA OR UNIX OR CYGWIN)
    set(RCC_ON_UNIX ON)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Generic")
    set(RCC_ON_UNIX OFF)
  else()
    message(SEND_ERROR "Unable to determine platform")
  endif()

  rcc_configure_additional_options()
  rcc_configure_standard_library()
  rcc_configure_platform_checks()
  rcc_configure_job_pools()

  if(RCC_ENABLE_ASSERTIONS)
    if(NOT WIN32 OR MINGW)
      add_compile_definitions(_DEBUG)
    endif()
    if(NOT buildType STREQUAL "DEBUG")
      add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX>:-UNDEBUG>")
      if(MSVC)
        foreach(rccFlagsVariable
            CMAKE_CXX_FLAGS_RELEASE CMAKE_CXX_FLAGS_RELWITHDEBINFO CMAKE_CXX_FLAGS_MINSIZEREL
            CMAKE_C_FLAGS_RELEASE CMAKE_C_FLAGS_RELWITHDEBINFO CMAKE_C_FLAGS_MINSIZEREL)
          string(REGEX REPLACE "(^| )[/-]D *NDEBUG($| )" " "
            ${rccFlagsVariable} "${${rccFlagsVariable}}")
        endforeach()
      endif()
    endif()
    add_compile_definitions(_GLIBCXX_ASSERTIONS)
    check_cxx_source_compiles([=[
      #define _LIBCPP_HARDENING_MODE _LIBCPP_HARDENING_MODE_EXTENSIVE
      #include <string>
      int main() { return 0; }
    ]=] RCC_SUPPORTS_LIBCXX_HARDENING_MODE)
    if(RCC_SUPPORTS_LIBCXX_HARDENING_MODE)
      add_compile_definitions(_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE)
    endif()
  endif()

  rcc_configure_standard_library_abi()
  rcc_configure_platform_link_options()
  rcc_configure_linker()
  rcc_configure_platform_options()
  rcc_configure_warning_options()

  if(RCC_USE_SANITIZER)
    rcc_configure_sanitizer_options()
  endif()
  rcc_configure_debug_options()
  rcc_configure_sections()
  if(MSVC)
    string(REGEX REPLACE "(^| ) */EH[-cs]+ *( |$)" "\\1 \\2"
      CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
    string(REGEX REPLACE "(^| ) */GR-? *( |$)" "\\1 \\2"
      CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
  endif()
  rcc_configure_profile_options()
  rcc_configure_pch_and_cache()
  rcc_configure_lto()
  rcc_configure_relative_paths()
  rcc_configure_platform_definitions()
endmacro()

macro(rcc_configure_sanitizer_options)
  set(ubsanFlags "${RCC_UBSAN_FLAGS}")
  set(sanitizerFlags)
  set(commonFlags ON)
  if(RCC_ON_UNIX)
    if(RCC_USE_SANITIZER STREQUAL "Address")
      list(APPEND sanitizerFlags -fsanitize=address)
    elseif(RCC_USE_SANITIZER STREQUAL "HWAddress")
      list(APPEND sanitizerFlags -fsanitize=hwaddress)
    elseif(RCC_USE_SANITIZER MATCHES "Memory(WithOrigins)?")
      list(APPEND sanitizerFlags -fsanitize=memory)
      if(RCC_USE_SANITIZER STREQUAL "MemoryWithOrigins")
        list(APPEND sanitizerFlags -fsanitize-memory-track-origins)
      endif()
    elseif(RCC_USE_SANITIZER STREQUAL "Undefined")
      list(APPEND sanitizerFlags ${ubsanFlags})
    elseif(RCC_USE_SANITIZER STREQUAL "Thread")
      list(APPEND sanitizerFlags -fsanitize=thread)
    elseif(RCC_USE_SANITIZER STREQUAL "DataFlow")
      list(APPEND sanitizerFlags -fsanitize=dataflow)
      set(commonFlags OFF)
    elseif(RCC_USE_SANITIZER STREQUAL "Address;Undefined" OR RCC_USE_SANITIZER STREQUAL "Undefined;Address")
      list(APPEND sanitizerFlags -fsanitize=address ${ubsanFlags})
    elseif(RCC_USE_SANITIZER STREQUAL "Leaks")
      list(APPEND sanitizerFlags -fsanitize=leak)
    else()
      message(FATAL_ERROR "Unsupported RCC_USE_SANITIZER value: ${RCC_USE_SANITIZER}")
    endif()
  elseif(MINGW OR MSVC)
    if(NOT RCC_USE_SANITIZER MATCHES "^(Address|Undefined|Address;Undefined|Undefined;Address)$")
      message(FATAL_ERROR "Unsupported sanitizer in this Windows environment: ${RCC_USE_SANITIZER}")
    endif()
    if("Address" IN_LIST RCC_USE_SANITIZER)
      if(MSVC AND NOT RCC_CLANG_CL)
        list(APPEND sanitizerFlags /fsanitize=address)
      else()
        list(APPEND sanitizerFlags -fsanitize=address)
      endif()
    endif()
    if("Undefined" IN_LIST RCC_USE_SANITIZER)
      if(MSVC AND NOT RCC_CLANG_CL)
        message(FATAL_ERROR "Undefined sanitizer requires clang-cl in the MSVC environment")
      endif()
      list(APPEND sanitizerFlags ${ubsanFlags})
    endif()
  else()
    message(FATAL_ERROR "RCC_USE_SANITIZER is not supported on this platform")
  endif()

  if(commonFlags)
    if(MSVC AND NOT RCC_CLANG_CL)
      rcc_append_flags("/Z7" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
      rcc_append_flags("/debug" CMAKE_EXE_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
      foreach(rccFlagsVariable CMAKE_EXE_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
        string(REGEX REPLACE "(^| )/INCREMENTAL($| )" " /INCREMENTAL:NO "
          ${rccFlagsVariable} "${${rccFlagsVariable}}")
      endforeach()
      if(CMAKE_C_COMPILER_ARCHITECTURE_ID STREQUAL "X86")
        rcc_append_flags("/Oy-" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
      endif()
    else()
      rcc_append_flags("-fno-omit-frame-pointer" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
      if(NOT buildType STREQUAL "DEBUG" AND NOT buildType STREQUAL "RELWITHDEBINFO"
          AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        rcc_append_flags("-gline-tables-only" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
      endif()
      if(buildType STREQUAL "DEBUG" AND RCC_OPTIMIZE_SANITIZED_BUILDS)
        rcc_append_flags("-O1" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
      endif()
    endif()
  endif()
  string(JOIN " " rccSanitizerFlags ${sanitizerFlags})
  rcc_append_flags("${rccSanitizerFlags}" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)

  if(MSVC)
    if(NOT RCC_CLANG_CL AND "Address" IN_LIST RCC_USE_SANITIZER)
      foreach(rccFlagsVariable CMAKE_CXX_FLAGS_${buildType} CMAKE_C_FLAGS_${buildType})
        string(REGEX REPLACE "(^| )/RTC[1csu]*($| )" " "
          ${rccFlagsVariable} "${${rccFlagsVariable}}")
      endforeach()
    endif()
    if(RCC_LINKER_IS_LLD_LINK AND "Address" IN_LIST RCC_USE_SANITIZER)
      if(CMAKE_C_COMPILER_ARCHITECTURE_ID STREQUAL "X86")
        set(runtimeArch i386)
      else()
        set(runtimeArch x86_64)
      endif()
      rcc_append_flags("/opt:nolldtailmerge clang_rt.asan_dynamic-${runtimeArch}.lib"
        CMAKE_EXE_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
      if(CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "^(MultiThreaded|MultiThreadedDebug)$")
        set(rccRuntimeThunk "clang_rt.asan_static_runtime_thunk-${runtimeArch}.lib")
      else()
        set(rccRuntimeThunk "clang_rt.asan_dynamic_runtime_thunk-${runtimeArch}.lib")
      endif()
      rcc_append_flags("/wholearchive:${rccRuntimeThunk}"
        CMAKE_EXE_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    endif()
  endif()

  if(RCC_USE_SANITIZE_COVERAGE)
    rcc_append_flags("-fsanitize=fuzzer-no-link" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
  endif()
  if(RCC_USE_SANITIZER MATCHES ".*Undefined.*")
    set(rccIgnorelist "${PROJECT_SOURCE_DIR}/utils/sanitizers/ubsan_ignorelist.txt")
    if(EXISTS "${rccIgnorelist}")
      rcc_append_flags("-fsanitize-ignorelist=\"${rccIgnorelist}\"" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()
  endif()
endmacro()

macro(rcc_configure_compiler_rt_path)
  if(RCC_CLANG_CL AND (RCC_BUILD_INSTRUMENTED OR RCC_USE_SANITIZER))
    execute_process(
      COMMAND "${CMAKE_CXX_COMPILER}" /clang:-print-libgcc-file-name /clang:--rtlib=compiler-rt
      OUTPUT_VARIABLE rccCompilerRTFile
      ERROR_VARIABLE rccClangCLError
      RESULT_VARIABLE rccClangCLResult
      OUTPUT_STRIP_TRAILING_WHITESPACE
      ERROR_STRIP_TRAILING_WHITESPACE)
    if(NOT rccClangCLResult STREQUAL "0")
      message(FATAL_ERROR "Unable to invoke clang-cl to find resource dir: ${rccClangCLError}")
    endif()
    file(TO_CMAKE_PATH "${rccCompilerRTFile}" rccCompilerRTFile)
    get_filename_component(rccRuntimeDir "${rccCompilerRTFile}" DIRECTORY)
    foreach(rccFlagsVariable CMAKE_EXE_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
      set(${rccFlagsVariable}
        "${CMAKE_CXX_LINKER_WRAPPER_FLAG}/libpath:\"${rccRuntimeDir}\" ${${rccFlagsVariable}}")
    endforeach()
  endif()
endmacro()

function(rcc_apply_options target)
  set(enableEH ${RCC_ENABLE_EH})
  set(enableRTTI ${RCC_ENABLE_RTTI})
  if(RCC_REQUIRES_EH)
    set(enableEH ON)
  endif()
  if(RCC_REQUIRES_RTTI)
    set(enableRTTI ON)
  endif()
  if(enableEH AND NOT enableRTTI)
    message(AUTHOR_WARNING "Exception handling requires RTTI; enabling RTTI for ${target}")
    set(enableRTTI ON)
  endif()
  set(cxxFlags)
  if(MSVC)
    if(enableEH)
      list(APPEND cxxFlags /EHsc)
    else()
      list(APPEND cxxFlags /EHs-c-)
      target_compile_definitions(${target} PRIVATE _HAS_EXCEPTIONS=0)
    endif()
    if(enableRTTI)
      list(APPEND cxxFlags /GR)
    else()
      list(APPEND cxxFlags /GR-)
    endif()
  elseif(RCC_GCC_COMPATIBLE)
    if(NOT enableEH)
      list(APPEND cxxFlags -fno-exceptions)
      if(RCC_ENABLE_UNWIND_TABLES)
        list(APPEND cxxFlags -funwind-tables)
      else()
        list(APPEND cxxFlags -fno-unwind-tables -fno-asynchronous-unwind-tables)
      endif()
    endif()
    if(NOT enableRTTI)
      list(APPEND cxxFlags -fno-rtti)
    endif()
  elseif(CMAKE_CXX_COMPILER_ID MATCHES "XL")
    if(NOT enableEH)
      list(APPEND cxxFlags -qnoeh)
    endif()
    if(NOT enableRTTI)
      list(APPEND cxxFlags -qnortti)
    endif()
  endif()
  target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:${cxxFlags}>")
  rcc_apply_link_options(${target})
endfunction()

macro(rcc_configure_additional_options)
