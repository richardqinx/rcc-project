  option(RCC_STATIC_LINK_CXX_STDLIB "Statically link the C++ standard library" OFF)
  option(RCC_ENABLE_LLD "Use lld as the linker" OFF)
  set(RCC_USE_LINKER "" CACHE STRING "Linker to select through the compiler driver")
  set(RCC_ENABLE_LTO OFF CACHE STRING "Enable LTO; use Thin or Full to select its mode")
  string(TOUPPER "${RCC_ENABLE_LTO}" rccLTOMode)
  option(RCC_ENABLE_FATLTO "Build with fat LTO objects" OFF)
  set(RCC_THINLTO_CACHE_PATH "${PROJECT_BINARY_DIR}/lto.cache" CACHE STRING "ThinLTO cache directory")
  option(RCC_NO_DEAD_STRIP "Disable removal of unused sections" OFF)
  option(RCC_USE_SPLIT_DWARF "Use split DWARF in debug builds" OFF)
  option(RCC_USE_SANITIZE_COVERAGE "Enable sanitizer coverage without the fuzzer main function" OFF)
  set(RCC_BUILD_INSTRUMENTED OFF CACHE STRING "PGO instrumentation: IR, Frontend, CSIR, CSSPGO")
  option(RCC_BUILD_INSTRUMENTED_COVERAGE "Build with code coverage instrumentation" OFF)
  mark_as_advanced(RCC_BUILD_INSTRUMENTED RCC_BUILD_INSTRUMENTED_COVERAGE)
  set(RCC_PROFDATA_FILE "" CACHE FILEPATH "Instrumentation profile to use when compiling")
  set(RCC_SPROFDATA_FILE "" CACHE FILEPATH "Sampling profile to use when compiling")
  set(RCC_CCACHE_BUILD OFF CACHE BOOL "Enable ccache for compilation")
  set(RCC_SOURCE_PREFIX "" CACHE STRING "Source prefix in mapped paths")
  option(RCC_USE_RELATIVE_PATHS_IN_DEBUG_INFO "Use relative paths in debug information" OFF)
  option(RCC_USE_RELATIVE_PATHS_IN_FILES "Use relative paths in source and debug information" OFF)
  if(CMAKE_SIZEOF_VOID_P EQUAL 8 AND NOT (WIN32 OR CMAKE_SYSTEM_NAME MATCHES "AIX"))
    option(RCC_BUILD_32_BITS "Build 32-bit binaries on a 64-bit platform" OFF)
  endif()
endmacro()

macro(rcc_configure_standard_library)
  set(RCC_LIBCXX_USED OFF)
  if(RCC_ENABLE_LIBCXX)
    if(RCC_GCC_COMPATIBLE)
      check_cxx_compiler_flag("-stdlib=libc++" RCC_COMPILER_SUPPORTS_LIBCXX)
      check_linker_flag(CXX "-stdlib=libc++" RCC_LINKER_SUPPORTS_LIBCXX)
      if(RCC_COMPILER_SUPPORTS_LIBCXX AND RCC_LINKER_SUPPORTS_LIBCXX)
        rcc_append_flags("-stdlib=libc++" CMAKE_CXX_FLAGS
          CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS)
        set(RCC_LIBCXX_USED ON)
      else()
        message(WARNING "Cannot select libc++ with -stdlib=")
      endif()
    else()
      message(WARNING "No libc++ selection flag is known for this compiler")
    endif()
  endif()
  if(RCC_STATIC_LINK_CXX_STDLIB)
    if(RCC_GCC_COMPATIBLE)
      check_cxx_compiler_flag("-static-libstdc++" RCC_COMPILER_SUPPORTS_STATIC_STDLIB)
      check_linker_flag(CXX "-static-libstdc++" RCC_LINKER_SUPPORTS_STATIC_STDLIB)
      if(RCC_COMPILER_SUPPORTS_STATIC_STDLIB AND RCC_LINKER_SUPPORTS_STATIC_STDLIB)
        rcc_append_flags("-static-libstdc++"
          CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS)
      else()
        message(WARNING "Cannot select static linking for the C++ standard library")
      endif()
    else()
      message(WARNING "No static C++ standard library selection flag is known for this compiler")
    endif()
  endif()
endmacro()

macro(rcc_configure_standard_library_abi)
  check_cxx_source_compiles([=[
    #include <iosfwd>
    #if !defined(__GLIBCXX__)
    #error Not libstdc++
    #endif
    int main() { return 0; }
  ]=] RCC_USES_LIBSTDCXX)
  check_cxx_source_compiles([=[
    #include <string>
    #if _GLIBCXX_USE_CXX11_ABI == 0
    #error C++11 ABI not active
    #endif
    int main() { return 0; }
  ]=] RCC_DEFAULT_GLIBCXX_CXX11_ABI)
  option(GLIBCXX_USE_CXX11_ABI "Use the libstdc++ C++11 ABI" ${RCC_DEFAULT_GLIBCXX_CXX11_ABI})
  if(RCC_USES_LIBSTDCXX)
    if(GLIBCXX_USE_CXX11_ABI)
      add_compile_definitions(_GLIBCXX_USE_CXX11_ABI=1)
    else()
      add_compile_definitions(_GLIBCXX_USE_CXX11_ABI=0)
    endif()
  endif()
endmacro()

macro(rcc_configure_linker)
  if(RCC_ENABLE_LLD)
    if(RCC_USE_LINKER)
      message(FATAL_ERROR "RCC_ENABLE_LLD and RCC_USE_LINKER cannot be set together")
    endif()
    if(MSVC)
      if(NOT CMAKE_LINKER MATCHES "lld-link")
        get_filename_component(rccCXXCompilerDir "${CMAKE_CXX_COMPILER}" DIRECTORY)
        get_filename_component(rccCCompilerDir "${CMAKE_C_COMPILER}" DIRECTORY)
        find_program(RCC_LLD_LINK NAMES lld-link lld-link.exe
          HINTS "${rccCXXCompilerDir}" "${rccCCompilerDir}")
        if(NOT RCC_LLD_LINK)
          message(FATAL_ERROR "RCC_ENABLE_LLD requires lld-link; set CMAKE_LINKER to its path")
        endif()
        set(CMAKE_LINKER "${RCC_LLD_LINK}")
      endif()
    else()
      set(RCC_USE_LINKER lld)
    endif()
  endif()
  if(RCC_USE_LINKER)
    check_cxx_source_compiles("int main() { return 0; }" RCC_CAN_LINK_EXECUTABLE)
    rcc_append_flags("-fuse-ld=${RCC_USE_LINKER}"
      CMAKE_EXE_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    if(RCC_CAN_LINK_EXECUTABLE)
      check_cxx_source_compiles("int main() { return 0; }" RCC_SUPPORTS_CUSTOM_LINKER)
      if(NOT RCC_SUPPORTS_CUSTOM_LINKER)
        message(FATAL_ERROR "The compiler cannot link with -fuse-ld=${RCC_USE_LINKER}")
      endif()
    else()
      message(STATUS "Skipping custom linker check: the target cannot link an executable")
    endif()
  endif()
  set(RCC_LINKER_IS_LLD OFF)
  set(RCC_LINKER_IS_LLD_LINK OFF)
  if(CMAKE_LINKER MATCHES ".*lld" OR RCC_USE_LINKER STREQUAL "lld" OR RCC_ENABLE_LLD)
    set(RCC_LINKER_IS_LLD ON)
  endif()
  if(CMAKE_LINKER MATCHES "lld-link" OR (MSVC AND (RCC_USE_LINKER STREQUAL "lld" OR RCC_ENABLE_LLD)))
    set(RCC_LINKER_IS_LLD_LINK ON)
  endif()
  if(NOT WIN32)
    if(APPLE)
      set(rccLinkerVersionFlag "-Wl,-v")
    else()
      set(rccLinkerVersionFlag "-Wl,--version")
    endif()
    if(CMAKE_HOST_WIN32)
      set(rccLinkerDevNull "NUL")
    else()
      set(rccLinkerDevNull "/dev/null")
    endif()
    if(RCC_USE_LINKER)
      set(rccLinkerCommand ${CMAKE_C_COMPILER} -fuse-ld=${RCC_USE_LINKER} ${rccLinkerVersionFlag} -o ${rccLinkerDevNull})
    else()
      separate_arguments(rccLinkerFlags UNIX_COMMAND "${CMAKE_EXE_LINKER_FLAGS}")
      set(rccLinkerCommand ${CMAKE_C_COMPILER} ${rccLinkerFlags} ${rccLinkerVersionFlag} -o ${rccLinkerDevNull})
    endif()
    execute_process(COMMAND ${rccLinkerCommand}
      OUTPUT_VARIABLE rccLinkerOutput ERROR_VARIABLE rccLinkerError)
    set(RCC_LINKER_IS_SOLARISLD OFF)
    set(RCC_LINKER_IS_GNULD OFF)
    if(rccLinkerOutput MATCHES "GNU ld")
      set(RCC_LINKER_IS_GNULD ON)
    endif()
    if(rccLinkerOutput MATCHES "Solaris Link Editors" OR rccLinkerError MATCHES "Solaris Link Editors")
      set(RCC_LINKER_IS_SOLARISLD ON)
    endif()
  endif()
  if(APPLE)
    if(NOT RCC_USE_LINKER)
      check_linker_flag(C "-Wl,-no_warn_duplicate_libraries" RCC_LINKER_SUPPORTS_NO_WARN_DUPLICATE_LIBRARIES)
    else()
      set(RCC_LINKER_SUPPORTS_NO_WARN_DUPLICATE_LIBRARIES OFF CACHE INTERNAL "")
    endif()
  endif()
endmacro()

function(rcc_has_no_incremental flags output)
  set(${output} OFF PARENT_SCOPE)
  string(FIND "${flags}" "/INCREMENTAL" position REVERSE)
  if(position GREATER -1)
    string(SUBSTRING "${flags}" ${position} 15 option)
    if(option MATCHES "/INCREMENTAL:NO")
      set(${output} ON PARENT_SCOPE)
    endif()
  endif()
endfunction()

macro(rcc_configure_msvc_options)
  add_compile_definitions(_CRT_SECURE_NO_DEPRECATE _CRT_SECURE_NO_WARNINGS
    _CRT_NONSTDC_NO_DEPRECATE _CRT_NONSTDC_NO_WARNINGS
    _SCL_SECURE_NO_DEPRECATE _SCL_SECURE_NO_WARNINGS UNICODE _UNICODE)
  rcc_append_flags("/Zc:inline /Oi /permissive-" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
  if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    rcc_append_flags("/Zc:preprocessor" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
  endif()
  rcc_append_flags("/Zc:__cplusplus /bigobj" CMAKE_CXX_FLAGS)
  set(RCC_WINSYSROOT "" CACHE STRING "Argument to clang-cl's /winsysroot")
  if(RCC_WINSYSROOT)
    if(NOT RCC_CLANG_CL)
      message(FATAL_ERROR "RCC_WINSYSROOT requires clang-cl")
    endif()
    rcc_append_flags("/winsysroot\"${RCC_WINSYSROOT}\"" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    if(RCC_LINKER_IS_LLD_LINK)
      rcc_append_flags("/winsysroot:\"${RCC_WINSYSROOT}\""
        CMAKE_EXE_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    endif()
  endif()
  option(RCC_ENABLE_PDB "Generate PDB files in Release builds" OFF)
  if(RCC_ENABLE_PDB AND buildType STREQUAL "RELEASE")
    rcc_append_flags("/Zi" CMAKE_C_FLAGS_RELEASE CMAKE_CXX_FLAGS_RELEASE)
    rcc_append_flags("/DEBUG /OPT:REF /OPT:ICF"
      CMAKE_EXE_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
  endif()
  set(rccAllLinkerFlags "")
  foreach(rccKind EXE MODULE SHARED)
    string(APPEND rccAllLinkerFlags
      " ${CMAKE_${rccKind}_LINKER_FLAGS_${buildType}} ${CMAKE_${rccKind}_LINKER_FLAGS}")
  endforeach()
  string(TOUPPER "${rccAllLinkerFlags}" rccAllLinkerFlags)
  if(RCC_CLANG_CL AND RCC_LINKER_IS_LLD AND rccAllLinkerFlags MATCHES "/DEBUG")
    rcc_add_supported_warning("-gcodeview-ghash" GCODEVIEW_GHASH)
  endif()
  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang" AND NOT RCC_ENABLE_LTO)
    foreach(rccKind EXE MODULE SHARED)
      rcc_has_no_incremental(
        "${CMAKE_${rccKind}_LINKER_FLAGS_${buildType}} ${CMAKE_${rccKind}_LINKER_FLAGS}"
        rccNoIncremental${rccKind})
    endforeach()
    if(rccNoIncrementalEXE AND rccNoIncrementalMODULE AND rccNoIncrementalSHARED)
      add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX>:/Brepro>")
      add_link_options("LINKER:/Brepro")
    else()
      message(WARNING "/Brepro is incompatible with incremental linking; output will not be deterministic")
    endif()
  endif()
endmacro()

macro(rcc_configure_platform_options)
  if(RCC_ENABLE_PIC)
    if(XCODE)
      message(WARNING "-fPIC is not supported with Xcode")
    elseif(NOT (WIN32 OR CYGWIN))
      check_c_compiler_flag("-Werror -fPIC" RCC_C_SUPPORTS_FPIC)
      check_cxx_compiler_flag("-Werror -fPIC" RCC_CXX_SUPPORTS_FPIC)
      if(RCC_C_SUPPORTS_FPIC AND RCC_CXX_SUPPORTS_FPIC)
        message(STATUS "Building with -fPIC")
        rcc_append_flags("-fPIC" CMAKE_C_FLAGS CMAKE_CXX_FLAGS CMAKE_ASM_FLAGS)
      else()
        message(WARNING "-fPIC is not supported")
      endif()
      if(NOT CMAKE_SYSTEM_NAME MATCHES "AIX" AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        rcc_add_supported_warning("-fno-semantic-interposition" FNO_SEMANTIC_INTERPOSITION)
      endif()
    endif()
  endif()
  if(NOT CMAKE_SYSTEM_NAME MATCHES "AIX" AND
      (NOT (WIN32 OR CYGWIN) OR ((MINGW OR CYGWIN) AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")))
    check_cxx_compiler_flag("-fvisibility-inlines-hidden" RCC_SUPPORTS_HIDDEN_INLINES)
    if(RCC_SUPPORTS_HIDDEN_INLINES)
      rcc_append_flags("-fvisibility-inlines-hidden" CMAKE_CXX_FLAGS)
    endif()
  endif()

  if((CMAKE_SIZEOF_VOID_P EQUAL 8 AND MINGW) OR CMAKE_SIZEOF_VOID_P EQUAL 4)
    add_compile_definitions(_FILE_OFFSET_BITS=64)
  endif()
  if(CMAKE_SIZEOF_VOID_P EQUAL 4)
    add_compile_definitions(_LARGEFILE_SOURCE)
  endif()
  if(CMAKE_SIZEOF_VOID_P EQUAL 8 AND NOT WIN32 AND RCC_BUILD_32_BITS)
    message(STATUS "Building 32 bits executables and libraries.")
    rcc_append_flags("-m32" CMAKE_C_FLAGS CMAKE_CXX_FLAGS
      CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS)
    add_compile_definitions(_LARGEFILE_SOURCE _FILE_OFFSET_BITS=64)
  endif()

  if(MSVC OR CMAKE_CXX_SIMULATE_ID STREQUAL "MSVC")
    add_link_options("$<$<STREQUAL:$<TARGET_PROPERTY:TYPE>,EXECUTABLE>:LINKER:/STACK:10000000>")
  elseif(MINGW OR CYGWIN)
    add_link_options("$<$<STREQUAL:$<TARGET_PROPERTY:TYPE>,EXECUTABLE>:LINKER:--stack,16777216>")
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
      rcc_append_flags("-Wa,-mbig-obj" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()
  endif()
  if(MSVC)
    rcc_configure_msvc_options()
  endif()
  if(XCODE)
    foreach(rccWarning
        GCC_WARN_ABOUT_RETURN_TYPE GCC_WARN_ABOUT_MISSING_NEWLINE GCC_WARN_UNUSED_VALUE
        GCC_WARN_UNUSED_VARIABLE GCC_WARN_SIGN_COMPARE GCC_WARN_UNUSED_FUNCTION
        GCC_WARN_INITIALIZER_NOT_FULLY_BRACKETED GCC_WARN_HIDDEN_VIRTUAL_FUNCTIONS
        GCC_WARN_UNINITIALIZED_AUTOS CLANG_WARN_BOOL_CONVERSION CLANG_WARN_EMPTY_BODY
        CLANG_WARN_ENUM_CONVERSION CLANG_WARN_INT_CONVERSION CLANG_WARN_CONSTANT_CONVERSION
        GCC_WARN_NON_VIRTUAL_DESTRUCTOR)
      set(CMAKE_XCODE_ATTRIBUTE_${rccWarning} YES)
    endforeach()
  endif()
  if(MSVC_IDE)
    set(RCC_COMPILER_JOBS "0" CACHE STRING "Parallel compiler jobs; 0 uses all processors")
    if(RCC_COMPILER_JOBS STREQUAL "0")
      add_compile_options(/MP)
    elseif(NOT RCC_COMPILER_JOBS STREQUAL "1")
      message(STATUS "Number of parallel compiler jobs set to ${RCC_COMPILER_JOBS}")
      add_compile_options("/MP${RCC_COMPILER_JOBS}")
    else()
      message(STATUS "Parallel compilation disabled")
    endif()
  endif()

endmacro()

macro(rcc_configure_sections)
  if(NOT CYGWIN AND NOT MSVC)
    if(NOT CMAKE_SYSTEM_NAME MATCHES "Darwin" AND NOT buildType STREQUAL "DEBUG")
      if(CMAKE_CXX_COMPILER_ID MATCHES "XL")
        rcc_append_flags("-qfuncsect" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
      else()
        rcc_append_flags("-ffunction-sections" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
      endif()
      rcc_append_flags("-fdata-sections" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()
  elseif(MSVC AND NOT buildType STREQUAL "DEBUG")
    rcc_append_flags("/Gw" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
  endif()
endmacro()

macro(rcc_configure_debug_options)
  if(RCC_USE_SPLIT_DWARF AND (buildType STREQUAL "DEBUG" OR buildType STREQUAL "RELWITHDEBINFO")
      AND CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
    add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX>:-gsplit-dwarf>")
    check_linker_flag(CXX "-Wl,--gdb-index" RCC_LINKER_SUPPORTS_GDB_INDEX)
    if(RCC_LINKER_SUPPORTS_GDB_INDEX)
      rcc_append_flags("-Wl,--gdb-index" CMAKE_EXE_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    endif()
  endif()
  if(RCC_ENABLE_PIC AND RCC_USING_GLIBC)
    check_cxx_source_compiles([=[
      #include <cstdio>
      #if __GLIBC__ < 2 || (__GLIBC__ == 2 && __GLIBC_MINOR__ < 36)
      #error RELR requires glibc 2.36
      #endif
      int main() { return 0; }
    ]=] RCC_GLIBC_SUPPORTS_RELR)
    if(RCC_GLIBC_SUPPORTS_RELR)
      check_linker_flag(CXX "-Wl,-z,pack-relative-relocs" RCC_LINKER_SUPPORTS_RELR)
      if(RCC_LINKER_SUPPORTS_RELR)
        rcc_append_flags("-Wl,-z,pack-relative-relocs"
          CMAKE_EXE_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
      endif()
    endif()
  endif()
  add_compile_definitions(__STDC_CONSTANT_MACROS __STDC_FORMAT_MACROS __STDC_LIMIT_MACROS)
  if(UNIX AND CMAKE_GENERATOR MATCHES "Ninja")
    if(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
      rcc_append_flags("-fdiagnostics-color" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()
    check_linker_flag(CXX "-Wl,--color-diagnostics" RCC_LINKER_SUPPORTS_COLOR_DIAGNOSTICS)
    if(RCC_LINKER_SUPPORTS_COLOR_DIAGNOSTICS)
      rcc_append_flags("-Wl,--color-diagnostics"
        CMAKE_EXE_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    endif()
  endif()
endmacro()

macro(rcc_configure_profile_options)
  string(TOUPPER "${RCC_BUILD_INSTRUMENTED}" rccProfileMode)
  if(RCC_BUILD_INSTRUMENTED OR RCC_BUILD_INSTRUMENTED_COVERAGE)
    if(NOT RCC_PROFILE_MERGE_POOL_SIZE)
      set(RCC_PROFILE_MERGE_POOL_SIZE 4)
    endif()
    if(NOT RCC_PROFILE_FILE_PATTERN)
      if(NOT RCC_PROFILE_DATA_DIR)
        file(TO_NATIVE_PATH "${PROJECT_BINARY_DIR}/profiles" RCC_PROFILE_DATA_DIR)
      endif()
      file(TO_NATIVE_PATH "${RCC_PROFILE_DATA_DIR}/%${RCC_PROFILE_MERGE_POOL_SIZE}m.profraw" RCC_PROFILE_FILE_PATTERN)
    endif()
    if(NOT RCC_CSPROFILE_FILE_PATTERN)
      if(NOT RCC_CSPROFILE_DATA_DIR)
        file(TO_NATIVE_PATH "${PROJECT_BINARY_DIR}/csprofiles" RCC_CSPROFILE_DATA_DIR)
      endif()
      file(TO_NATIVE_PATH "${RCC_CSPROFILE_DATA_DIR}/%${RCC_PROFILE_MERGE_POOL_SIZE}m.profraw" RCC_CSPROFILE_FILE_PATTERN)
    endif()
  endif()
  if(RCC_BUILD_INSTRUMENTED AND RCC_BUILD_INSTRUMENTED_COVERAGE)
    message(FATAL_ERROR "PGO instrumentation and coverage instrumentation cannot both be enabled")
  endif()
  if(RCC_BUILD_INSTRUMENTED)
    if(rccProfileMode STREQUAL "IR")
      set(rccProfileFlags "-fprofile-generate=\"${RCC_PROFILE_DATA_DIR}\"")
    elseif(rccProfileMode STREQUAL "CSIR")
      set(rccProfileFlags "-fcs-profile-generate=\"${RCC_CSPROFILE_DATA_DIR}\"")
    elseif(rccProfileMode STREQUAL "CSSPGO")
      if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        message(FATAL_ERROR "RCC_BUILD_INSTRUMENTED=CSSPGO requires Clang")
      endif()
      set(rccProfileFlags
        "-fno-omit-frame-pointer -mno-omit-leaf-frame-pointer -fno-optimize-sibling-calls -fpseudo-probe-for-profiling -fdebug-info-for-profiling")
    else()
      set(rccProfileFlags "-fprofile-instr-generate=\"${RCC_PROFILE_FILE_PATTERN}\"")
    endif()
    rcc_append_flags("${rccProfileFlags}" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    if(NOT RCC_LINKER_IS_LLD_LINK)
      rcc_append_flags("${rccProfileFlags}" CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    endif()
  endif()
  rcc_configure_compiler_rt_path()

  if(RCC_PROFDATA_FILE AND EXISTS "${RCC_PROFDATA_FILE}")
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
      message(FATAL_ERROR "RCC_PROFDATA_FILE requires Clang")
    endif()
    rcc_append_flags("-fprofile-instr-use=\"${RCC_PROFDATA_FILE}\"" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    if(NOT RCC_LINKER_IS_LLD_LINK)
      rcc_append_flags("-fprofile-instr-use=\"${RCC_PROFDATA_FILE}\""
        CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    endif()
  elseif(RCC_PROFDATA_FILE)
    message(WARNING "RCC_PROFDATA_FILE does not exist: ${RCC_PROFDATA_FILE}")
  endif()
  if(RCC_SPROFDATA_FILE AND EXISTS "${RCC_SPROFDATA_FILE}")
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
      message(FATAL_ERROR "RCC_SPROFDATA_FILE requires Clang")
    endif()
    set(rccSampleFlags "-fpseudo-probe-for-profiling -fprofile-sample-use=\"${RCC_SPROFDATA_FILE}\"")
    rcc_append_flags("${rccSampleFlags}" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    if(NOT RCC_LINKER_IS_LLD_LINK)
      rcc_append_flags("${rccSampleFlags}" CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    endif()
  endif()
  if(RCC_BUILD_INSTRUMENTED_COVERAGE)
    rcc_append_flags("-fprofile-instr-generate=\"${RCC_PROFILE_FILE_PATTERN}\" -fcoverage-mapping"
      CMAKE_C_FLAGS CMAKE_CXX_FLAGS CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
  endif()
endmacro()

macro(rcc_configure_lto)
  if(RCC_ENABLE_LTO AND WIN32 AND NOT RCC_LINKER_IS_LLD_LINK AND NOT MINGW)
    message(FATAL_ERROR "LTO on Windows requires lld-link; set CMAKE_LINKER to its path")
  endif()
  if(RCC_ENABLE_LTO)
    if(rccLTOMode STREQUAL "THIN")
      set(rccLTOFlag "-flto=thin")
    elseif(rccLTOMode STREQUAL "FULL")
      set(rccLTOFlag "-flto=full")
    else()
      set(rccLTOFlag "-flto")
    endif()
    rcc_append_flags("${rccLTOFlag}" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    if(NOT RCC_LINKER_IS_LLD_LINK)
      rcc_append_flags("${rccLTOFlag}" CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    endif()
  endif()
  if(rccLTOMode STREQUAL "THIN")
    if(APPLE)
      rcc_append_flags("-Wl,-cache_path_lto,${RCC_THINLTO_CACHE_PATH}"
        CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    elseif(CMAKE_SYSTEM_NAME MATCHES "AIX")
      rcc_append_flags("-bplugin_opt:-legacy-thinlto-cache-dir=${RCC_THINLTO_CACHE_PATH}"
        CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    elseif((UNIX OR MINGW) AND RCC_USE_LINKER STREQUAL "lld")
      rcc_append_flags("-Wl,--thinlto-cache-dir=${RCC_THINLTO_CACHE_PATH}"
        CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    elseif(RCC_USE_LINKER STREQUAL "gold")
      rcc_append_flags("-Wl,--plugin-opt,cache-dir=${RCC_THINLTO_CACHE_PATH}"
        CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    elseif(RCC_LINKER_IS_LLD_LINK)
      rcc_append_flags("/lldltocache:${RCC_THINLTO_CACHE_PATH}"
        CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
    endif()
  endif()
  if(RCC_ENABLE_FATLTO AND ((UNIX AND NOT APPLE) OR FUCHSIA))
    rcc_append_flags("-ffat-lto-objects" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    if(NOT RCC_LINKER_IS_LLD_LINK)
      rcc_append_flags("-ffat-lto-objects"
        CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS)
    endif()
  endif()
endmacro()

macro(rcc_configure_pch_and_cache)
  if(NOT DEFINED CMAKE_DISABLE_PRECOMPILE_HEADERS)
    if(CMAKE_SYSTEM_NAME MATCHES "OS390")
      message(NOTICE "Precompiled headers are disabled by default on z/OS. "
        "Pass -DCMAKE_DISABLE_PRECOMPILE_HEADERS=OFF to override.")
      set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)
    endif()
    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
      message(NOTICE "Precompiled headers are disabled by default with GCC. "
        "Pass -DCMAKE_DISABLE_PRECOMPILE_HEADERS=OFF to override.")
      set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)
    endif()
    if(CMAKE_CXX_COMPILER_LAUNCHER MATCHES "sccache")
      message(NOTICE "Precompiled headers are disabled by default with sccache. "
        "Pass -DCMAKE_DISABLE_PRECOMPILE_HEADERS=OFF to override.")
      set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)
    elseif(CMAKE_CXX_COMPILER_LAUNCHER MATCHES "clang-cache")
      message(NOTICE "Precompiled headers are disabled by default with clang-cache. "
        "Pass -DCMAKE_DISABLE_PRECOMPILE_HEADERS=OFF to override.")
      set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)
    elseif(RCC_CCACHE_BUILD OR CMAKE_CXX_COMPILER_LAUNCHER MATCHES "ccache")
      if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        message(WARNING "Using ccache with precompiled headers with non-Clang "
          "compilers is not supported and may lead to false positives. "
          "Set CMAKE_DISABLE_PRECOMPILE_HEADERS to ON/OFF to silence this warning.")
        set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)
      endif()
      if(CMAKE_HOST_WIN32)
        message(WARNING "Using ccache with precompiled headers on Windows is "
          "currently not supported. "
          "Pass -DCMAKE_DISABLE_PRECOMPILE_HEADERS=OFF to override.")
        set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)
      endif()
    endif()
  endif()
  if(NOT CMAKE_DISABLE_PRECOMPILE_HEADERS)
    message(STATUS "Precompiled headers enabled.")
    set(CMAKE_PCH_PROLOGUE "")
    if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
      rcc_append_flags("-Xclang -fno-pch-timestamp" CMAKE_CXX_FLAGS)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
      rcc_append_flags("-fpch-preprocess" CMAKE_CXX_FLAGS)
    endif()
  else()
    message(STATUS "Precompiled headers disabled.")
  endif()
  if(RCC_CCACHE_BUILD)
    find_program(RCC_CCACHE_PROGRAM ccache)
    if(NOT RCC_CCACHE_PROGRAM)
      message(FATAL_ERROR "ccache was not found; install it or disable RCC_CCACHE_BUILD")
    endif()
    set(RCC_CCACHE_MAXSIZE "" CACHE STRING "ccache size limit")
    set(RCC_CCACHE_DIR "" CACHE STRING "ccache storage directory")
    set(RCC_CCACHE_PARAMS "CCACHE_CPP2=yes CCACHE_HASHDIR=yes CCACHE_SLOPPINESS=pch_defines,time_macros"
      CACHE STRING "Environment assignments for ccache")
    if(NOT CMAKE_HOST_WIN32)
      set(rccCacheCommand "${RCC_CCACHE_PARAMS} \"${RCC_CCACHE_PROGRAM}\"")
      if(NOT CMAKE_DISABLE_PRECOMPILE_HEADERS)
        set(rccCacheCommand "CCACHE_DEPEND=1 ${rccCacheCommand}")
      endif()
      if(RCC_CCACHE_MAXSIZE)
        set(rccCacheCommand "CCACHE_MAXSIZE=${RCC_CCACHE_MAXSIZE} ${rccCacheCommand}")
      endif()
      if(RCC_CCACHE_DIR)
        set(rccCacheCommand "CCACHE_DIR=\"${RCC_CCACHE_DIR}\" ${rccCacheCommand}")
      endif()
      set_property(GLOBAL PROPERTY RULE_LAUNCH_COMPILE "${rccCacheCommand}")
      message(STATUS "ccache program: ${rccCacheCommand}")
    else()
      if(RCC_CCACHE_MAXSIZE OR RCC_CCACHE_DIR OR
          NOT RCC_CCACHE_PARAMS MATCHES "CCACHE_CPP2=yes CCACHE_HASHDIR=yes CCACHE_SLOPPINESS=pch_defines,time_macros")
        message(FATAL_ERROR "Configure ccache through environment variables on Windows")
      endif()
      set(CMAKE_C_COMPILER_LAUNCHER "${RCC_CCACHE_PROGRAM}")
      set(CMAKE_CXX_COMPILER_LAUNCHER "${RCC_CCACHE_PROGRAM}")
      message(STATUS "ccache program: ${RCC_CCACHE_PROGRAM}")
    endif()
  endif()
endmacro()

macro(rcc_configure_relative_paths)
  if(RCC_USE_RELATIVE_PATHS_IN_DEBUG_INFO OR RCC_USE_RELATIVE_PATHS_IN_FILES)
    if(RCC_ENABLE_PROJECTS)
      get_filename_component(rccSourceRoot "${PROJECT_SOURCE_DIR}/.." ABSOLUTE)
    else()
      set(rccSourceRoot "${PROJECT_SOURCE_DIR}")
    endif()
    file(RELATIVE_PATH rccRelativeRoot "${CMAKE_BINARY_DIR}" "${rccSourceRoot}")
  endif()
  if(RCC_USE_RELATIVE_PATHS_IN_DEBUG_INFO)
    check_c_compiler_flag("-fdebug-prefix-map=foo=bar" RCC_SUPPORTS_FDEBUG_PREFIX_MAP)
    if(RCC_SUPPORTS_FDEBUG_PREFIX_MAP)
      rcc_append_flags("-fdebug-prefix-map=\"${CMAKE_BINARY_DIR}=${rccRelativeRoot}\" -fdebug-prefix-map=\"${rccSourceRoot}/=${RCC_SOURCE_PREFIX}\""
        CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()
    if(RCC_GCC_COMPATIBLE)
      rcc_append_flags("-no-canonical-prefixes" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()
  endif()
  if(RCC_USE_RELATIVE_PATHS_IN_FILES)
    check_c_compiler_flag("-ffile-prefix-map=foo=bar" RCC_SUPPORTS_FFILE_PREFIX_MAP)
    if(RCC_SUPPORTS_FFILE_PREFIX_MAP)
      rcc_append_flags("-ffile-prefix-map=\"${CMAKE_BINARY_DIR}=${rccRelativeRoot}\" -ffile-prefix-map=\"${rccSourceRoot}/=${RCC_SOURCE_PREFIX}\""
        CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()
    if(RCC_GCC_COMPATIBLE)
      rcc_append_flags("-no-canonical-prefixes" CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
    endif()
  endif()
endmacro()

function(rcc_apply_link_options target)
  if(NOT buildType STREQUAL "DEBUG")
    if(NOT RCC_NO_DEAD_STRIP)
      if(CMAKE_SYSTEM_NAME MATCHES "Darwin")
        target_link_options(${target} PRIVATE "LINKER:-dead_strip")
      elseif(CMAKE_SYSTEM_NAME STREQUAL "SunOS" AND RCC_LINKER_IS_SOLARISLD)
        check_linker_flag(CXX "-Wl,-z,discard-unused=sections" RCC_LINKER_SUPPORTS_DISCARD_UNUSED)
        if(RCC_LINKER_SUPPORTS_DISCARD_UNUSED)
          target_link_options(${target} PRIVATE "LINKER:-z,discard-unused=sections")
        endif()
      elseif(NOT MSVC AND NOT CMAKE_CXX_SIMULATE_ID STREQUAL "MSVC" AND NOT CMAKE_SYSTEM_NAME MATCHES "AIX|OS390")
        target_link_options(${target} PRIVATE "LINKER:--gc-sections")
      endif()
    elseif(CMAKE_SYSTEM_NAME MATCHES "AIX")
      target_link_options(${target} PRIVATE "LINKER:-bnogc")
    endif()
  endif()
  if(RCC_LINKER_SUPPORTS_NO_WARN_DUPLICATE_LIBRARIES)
    target_link_options(${target} PRIVATE "LINKER:-no_warn_duplicate_libraries")
  endif()
endfunction()
